{
  "categories": [
    {
      "title": "### 新增",
      "labels": [
        "type: feature"
      ]
    },
    {
      "title": "### 修复",
      "labels": [
        "type: bugfix"
      ]
    },
    {
      "title": "### 改进",
      "labels": [
        "type: refactor",
        "type: translation"
      ]
    }
  ],
  "sort": "ASC",
  "template": "## [#{{VERSION}}]\n\n#{{CHANGELOG}}",
  "pr_template": "- #{{TITLE}}",
  "custom_placeholders": [
    {
      "name": "VERSION",
      "source": "TO_TAG",
      "transformer": {
        "pattern": "v?([0-9\\.]+)(-[0-9\\.]+)?",
        "target": "$1"
      }
    }
  ],
  "empty_template": "",
  "ignore_labels": [
    "ignore changelog"
  ],
  "tag_resolver": {
    "method": "semver",
    "filter": {
      "pattern": "^(?!v?[0-9\\.]+(-1\\.21)$).+$",
      "flags": "gu"
    },
    "transformer": {
      "pattern": "v?([0-9\\.]+)(-[0-9\\.]+)?",
      "target": "$1"
    }
  },
  "max_pull_requests": 1000,
  "max_back_track_time_days": 365,
  "base_branches": [
    "1.21"
  ]
}
